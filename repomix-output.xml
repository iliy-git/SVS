<file path="resources/views/components/configs/⚡add_from_node.blade.php">
<?php

use App\Models\Subscription;
use App\Services\ConfigService;
use Livewire\Component;
use App\Models\Node;
use App\Models\Config;
use Illuminate\Support\Facades\Http;

new class extends Component {
    public $clientId;
    public $subId;

    public $step = 1;
    public $selectedNode = null;
    public $remoteConfigs = [];
    public $existingLinks = [];
    public $allRemoteData = [];

    public function mount($clientId, $subId)
    {
        $this->clientId = $clientId;
        $this->subId = $subId;
    }

    /**
     * Шаг 1: Загрузка данных с ноды
     */
    public function fetchConfigs($nodeId, ConfigService $service)
    {
        $this->selectedNode = Node::findOrFail($nodeId);

        try {
            $this->allRemoteData = $service->fetchRemoteConfigs($this->selectedNode);

            $this->existingLinks = Config::pluck('link')->toArray();

            $this->remoteConfigs = collect($this->allRemoteData)
                ->map(fn($item) => $item['link'])
                ->sortBy(fn($link) => in_array(trim($link), $this->existingLinks))
                ->values()
                ->all();

            $this->step = 2;
        } catch (\Exception $e) {
            session()->flash('error', $e->getMessage());
        }
    }

    /**
     * Шаг 2: Сохранение выбранного конфига
     */
    public function saveRemoteConfig($link, ConfigService $service)
    {
        try {
            $service->importFromNode(
                $this->subId,
                $this->selectedNode,
                $link,
                $this->allRemoteData
            );

            return $this->redirectRoute('configs.index', [$this->clientId, $this->subId], navigate: true);
        } catch (\Exception $e) {
            session()->flash('error', 'Не удалось импортировать: ' . $e->getMessage());
        }
    }
}; ?>

